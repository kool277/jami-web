{
  "name": "jami-web-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsc-watch --build ../common --onSuccess \"vite --mode development\"",
    "start:prod": "vite preview --mode production",
    "build": "tsc --build && vite build --mode production",
    "clean": "rm -rf dist *.tsbuildinfo",
    "cy": "cypress run",
    "cy:open": "cypress open",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "extract-translations": "i18next"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/lab": "^7.0.1-beta.23",
    "@mui/material": "^7.3.9",
    "@reduxjs/toolkit": "^2.2.7",
    "@sentry/node": "^8.26.0",
    "@sentry/react": "^8.26.0",
    "@sentry/tracing": "^7.114.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.51.23",
    "@tanstack/react-query-devtools": "^5.51.23",
    "@tanstack/react-virtual": "^3.11.3",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "axios": "^1.7.4",
    "check-password-strength": "^2.0.10",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.12",
    "emoji-picker-react": "^4.11.1",
    "filesize": "^10.1.4",
    "framer-motion": "^11.3.28",
    "i18next": "^23.13.0",
    "linkify-react": "^4.1.3",
    "linkifyjs": "^4.1.3",
    "mime": "^4.0.4",
    "qrcode.react": "^3.1.0",
    "react": "^19.2.4",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.4",
    "react-draggable": "^4.4.6",
    "react-dropzone": "^14.2.3",
    "react-emoji-render": "^2.0.1",
    "react-i18next": "^15.0.1",
    "react-modal": "^3.16.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.1",
    "react-waypoint": "^10.3.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@stylistic/eslint-plugin-js": "^2.6.4",
    "@types/byte-size": "^8.1.2",
    "@types/crypto-js": "^4.2.0",
    "@types/node": "^22.4.0",
    "@types/react": "^19.2.14",
    "@types/react-color": "^3.0.12",
    "@types/react-dom": "^19.2.3",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^4.3.1",
    "cypress": "^13.13.3",
    "eslint-plugin-cypress": "^3.5.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "i18next-parser": "^9.0.2",
    "sass": "^1.77.8",
    "tsc-watch": "^6.2.0",
    "typescript": "~5.5.4",
    "vite": "^5.4.1",
    "vite-plugin-svgr": "^4.2.0",
    "vite-plugin-top-level-await": "^1.4.4"
  }
}
