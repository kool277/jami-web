{
  "name": "jami-web",
  "version": "1.0.0",
  "main": ".vite/build/main.js",
  "type": "module",
  "workspaces": [
    "common",
    "daemon/bin/nodejs",
    "client",
    "server"
  ],
  "scripts": {
    "start": "concurrently \"npm start --workspace server\" \"npm start --workspace client\"",
    "start:prod": " npm run start:prod --workspace server",
    "start:debug-server": "HOME=/tmp npm start --workspace server",
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces",
    "clean:all": "npm run clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "prepare": "if [ -e '.git' ]; then git config core.hooksPath .hooks; fi",
    "test": "npx cypress run  --project ./client",
    "electron:build": "npm run build && npx tsc --project electron/tsconfig.json",
    "electron:start": "npm run build && electron-forge start",
    "electron:package": "npm run build && electron-forge package",
    "electron:make": "npm run build && electron-forge make"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/core": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.58.2",
    "@tony.ganchev/eslint-plugin-header": "^3.1.2",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "concurrently": "^8.2.2",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.5.0",
    "eslint-plugin-html": "^8.1.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.3",
    "globals": "^15.9.0",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "byte-size": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "qr-scanner": "^1.4.2",
    "vcard4-ts": "^0.4.1"
  },
  "config": {
    "forge": "forge.config.js"
  }
}
