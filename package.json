{
  "name": "jami-web",
  "version": "1.0.0",
  "main": ".vite/build/main.js",
  "type": "module",
  "workspaces": [
    "common",
    "client",
    "server"
  ],
  "scripts": {
    "start": "concurrently \"npm start --workspace server\" \"npm start --workspace client\"",
    "start:prod": " npm run start:prod --workspace server",
    "start:debug-server": "HOME=/tmp npm start --workspace server",
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces",
    "clean:all": "npm run clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "prepare": "if [ -e '.git' ] && command -v git > /dev/null 2>&1; then git config core.hooksPath .hooks; fi",
    "test": "npx playwright test --project=chromium",
    "test:ui": "npx playwright test --ui",
    "npm:pack": "npm pack --workspace @savoirfairelinux/jami-web",
    "npm:publish": "npm publish --workspace @savoirfairelinux/jami-web --tag next",
    "electron:build": "npm run build && npx tsc --project electron/tsconfig.json",
    "electron:start": "npm run build && electron-forge start",
    "electron:package": "npm run build && electron-forge package",
    "electron:make": "npm run build && electron-forge make"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/core": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.61.1",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^25.9.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.6",
    "electron": "^42.6.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "express": "^4.22.2",
    "globals": "^15.15.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "ws": "^8.21.0"
  },
  "config": {
    "forge": "forge.config.js"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "macos-alias@0.2.12": true,
    "fs-xattr@0.3.1": true
  }
}
