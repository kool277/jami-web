{
  "compilerOptions": {
    "composite": true,
    "target": "es2022",
    "module": "es2022",
    "rootDir": "src",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "references": [{ "path": "../common" }, { "path": "../core" }],
  "include": ["src"],
  "exclude": ["test", "vitest.config.ts", "native"]
}
