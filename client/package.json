{
  "name": "jami-web-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsc-watch --build ../common --onSuccess \"vite --mode development\"",
    "start:prod": "vite preview --mode production",
    "build": "tsc --build && vite build --mode production",
    "clean": "rm -rf dist ../server/client/dist *.tsbuildinfo",
    "cy": "cypress run",
    "cy:open": "cypress open",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "extract-translations": "i18next"
  },
  "browserslist": {
    "production": [
      "Chrome >= 117",
      "Edge >= 121",
      "Firefox >= 121",
      "Safari >= 17",
      "iOS >= 17"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/lab": "^9.0.0-beta.3",
    "@mui/material": "^9.0.1",
    "@popperjs/core": "^2.11.8",
    "@reduxjs/toolkit": "^2.2.7",
    "@sentry/node": "^8.26.0",
    "@sentry/react": "^8.26.0",
    "@sentry/tracing": "^7.114.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.26",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "axios": "^1.16.1",
    "check-password-strength": "^2.0.10",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.12",
    "emoji-picker-react": "^4.19.1",
    "filesize": "^11.0.17",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.0",
    "link-preview-js": "4.0.3",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "material-symbols": "^0.44.10",
    "mime": "^4.1.0",
    "qrcode.react": "^4.2.0",
    "qr-scanner": "^1.4.2",
    "react": "^19.2.6",
    "react-color": "^2.19.3",
    "react-dom": "^19.2.6",
    "react-draggable": "^4.6.0",
    "react-dropzone": "^15.0.0",
    "react-emoji-render": "^2.0.1",
    "react-i18next": "^17.0.8",
    "react-intersection-observer": "^10.0.3",
    "react-modal": "^3.16.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@mui/types": "^9.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/crypto-js": "^4.2.0",
    "@types/node": "^22.4.0",
    "@types/react": "^19.2.14",
    "@types/react-color": "^3.0.12",
    "@types/react-dom": "^19.2.3",
    "@types/react-modal": "^3.16.3",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.0.2",
    "cypress": "^15.16.0",
    "esbuild": "^0.28.0",
    "eslint-plugin-cypress": "^6.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hermes-parser": "^0.36.1",
    "i18next-cli": "^1.58.0",
    "rollup": "^4.60.4",
    "sass": "^1.100.0",
    "tsc-watch": "^7.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-svgr": "^5.2.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^4.0.2"
  }
}
